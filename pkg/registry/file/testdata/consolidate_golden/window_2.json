{
  "name": "replicaset-web-abc-web-0002",
  "namespace": "default",
  "labels": {
    "kubescape.io/workload-container-name": "web"
  },
  "annotations": {
    "kubescape.io/report-series-id": "series-1",
    "kubescape.io/status": "ready"
  },
  "Spec": {
    "Architectures": [
      "amd64"
    ],
    "Capabilities": [
      "NET_BIND_SERVICE"
    ],
    "Execs": [
      {
        "Path": "/bin/sh",
        "Args": [
          "-c",
          "echo hi"
        ]
      },
      {
        "Path": "/usr/bin/wget",
        "Args": [
          "https://example.org"
        ]
      }
    ],
    "Opens": [
      {
        "Path": "/etc/config",
        "Flags": [
          "O_WRONLY"
        ]
      },
      {
        "Path": "/var/log/pods/pod-d/app.log",
        "Flags": [
          "O_RDONLY"
        ]
      },
      {
        "Path": "/var/log/pods/pod-e/app.log",
        "Flags": [
          "O_RDONLY"
        ]
      },
      {
        "Path": "/var/log/pods/pod-f/app.log",
        "Flags": [
          "O_RDONLY"
        ]
      }
    ],
    "Syscalls": [
      "read",
      "futex",
      "epoll_wait"
    ],
    "Endpoints": [
      {
        "Endpoint": ":8080/api/v1/users",
        "Methods": [
          "POST"
        ],
        "Internal": false,
        "Direction": "inbound",
        "Headers": {
          "Content-Type": [
            "application/json"
          ]
        }
      },
      {
        "Endpoint": ":8080/api/v1/health",
        "Methods": [
          "GET"
        ],
        "Internal": false,
        "Direction": "inbound",
        "Headers": {}
      }
    ],
    "PolicyByRuleId": {
      "R100": {
        "AllowedProcesses": [
          "/usr/bin/curl"
        ],
        "AllowedContainer": true
      }
    },
    "Ingress": [
      {
        "Identifier": "pod-c",
        "Type": "internal",
        "IPAddress": "10.244.1.12",
        "Ports": [
          {
            "Name": "TCP-8080",
            "Protocol": "TCP",
            "Port": 8080
          }
        ]
      },
      {
        "Identifier": "pod-d",
        "Type": "internal",
        "IPAddress": "10.244.1.23",
        "Ports": [
          {
            "Name": "TCP-8080",
            "Protocol": "TCP",
            "Port": 8080
          }
        ]
      },
      {
        "Identifier": "kubelet-probe",
        "Type": "internal",
        "IPAddress": "10.250.0.2",
        "Ports": [
          {
            "Name": "TCP-8080",
            "Protocol": "TCP",
            "Port": 8080
          }
        ]
      }
    ],
    "Egress": [
      {
        "Identifier": "dns-kube-dns",
        "Type": "internal",
        "DNSNames": [
          "kube-dns.kube-system.svc.cluster.local."
        ],
        "IPAddress": "10.96.0.10",
        "Ports": [
          {
            "Name": "UDP-53",
            "Protocol": "UDP",
            "Port": 53
          },
          {
            "Name": "TCP-53",
            "Protocol": "TCP",
            "Port": 53
          }
        ]
      },
      {
        "Identifier": "github-2",
        "Type": "external",
        "DNSNames": [
          "github.com."
        ],
        "IPAddress": "140.82.121.4",
        "Ports": [
          {
            "Name": "TCP-443",
            "Protocol": "TCP",
            "Port": 443
          }
        ]
      },
      {
        "Identifier": "collide",
        "Type": "internal",
        "ServiceRefNamespace": "honey",
        "ServiceRefName": "alertmanager",
        "Ports": [
          {
            "Name": "TCP-9093",
            "Protocol": "TCP",
            "Port": 9093
          }
        ]
      },
      {
        "Identifier": "collide",
        "Type": "internal",
        "Entity": "host"
      }
    ]
  }
}
