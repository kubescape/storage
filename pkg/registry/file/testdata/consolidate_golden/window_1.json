      },
      {
        "Path": "/var/log/pods/pod-b/app.log",
        "Flags": [
          "O_RDONLY"
        ]
      },
      {
        "Path": "/var/log/pods/pod-c/app.log",
        "Flags": [
          "O_RDONLY"
        ]
      }
    ],
    "Syscalls": [
