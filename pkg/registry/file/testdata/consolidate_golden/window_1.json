        "Type": "internal",
        "IPAddress": "10.244.1.7",
        "Ports": [
          {
            "Name": "TCP-8080",
            "Protocol": "TCP",
            "Port": 8080
          }
        ]
      },
      {
        "Identifier": "pod-b",
