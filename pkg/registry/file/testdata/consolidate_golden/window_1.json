        "Internal": false,
        "Direction": "inbound",
        "Headers": {
          "Accept": [
            "application/json"
          ]
        }
      }
    ],
    "PolicyByRuleId": {
      "R100": {
        "AllowedProcesses": [
          "/bin/sh"
        ],
        "AllowedContainer": false
