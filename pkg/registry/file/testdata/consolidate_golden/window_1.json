{
  "name": "replicaset-web-abc-web-0001",
  "namespace": "default",
  "labels": {
    "kubescape.io/workload-container-name": "web"
  },
  "annotations": {
    "kubescape.io/report-series-id": "series-1",
    "kubescape.io/status": "ready"
  },
  "Spec": {
    "Architectures": ["amd64", "arm64"],
    "Capabilities": ["SYS_ADMIN", "NET_BIND_SERVICE"],
    "Execs": [
      {"Path": "/bin/sh", "Args": ["-c", "echo hi"]},
      {"Path": "/usr/bin/curl", "Args": ["https://example.com"]}
    ],
    "Opens": [
      {"Path": "/etc/config", "Flags": ["O_RDONLY"]},
      {"Path": "/var/log/pods/pod-a/app.log", "Flags": ["O_RDONLY", "O_CLOEXEC"]},
      {"Path": "/var/log/pods/pod-b/app.log", "Flags": ["O_RDONLY"]},
      {"Path": "/var/log/pods/pod-c/app.log", "Flags": ["O_RDONLY"]}
    ],
    "Syscalls": ["write", "read", "openat"],
    "Endpoints": [
      {
        "Endpoint": ":8080/api/v1/users",
        "Methods": ["GET"],
        "Internal": false,
        "Direction": "inbound",
        "Headers": {"Accept": ["application/json"]}
      }
    ],
    "PolicyByRuleId": {
      "R100": {"AllowedProcesses": ["/bin/sh"], "AllowedContainer": false}
    },
    "IdentifiedCallStacks": [
      {"CallID": "cs-1", "CallStack": {"Root": {"Frame": {"FileID": "10", "Lineno": "1", "FrameType": 0}, "Children": []}}}
    ],
    "Ingress": [
      {"Identifier": "h1", "Type": "external", "IPAddress": "10.0.0.1", "Ports": [{"Name": "TCP-80", "Protocol": "TCP", "Port": 80}]},
      {"Identifier": "h2", "Type": "external", "IPAddress": "10.0.0.2", "Ports": [{"Name": "TCP-80", "Protocol": "TCP", "Port": 80}]}
    ],
    "Egress": [
      {"Identifier": "dns", "Type": "external", "DNSNames": ["kubernetes.default.svc.cluster.local"], "Ports": [{"Name": "UDP-53", "Protocol": "UDP", "Port": 53}]}
    ]
  }
}
