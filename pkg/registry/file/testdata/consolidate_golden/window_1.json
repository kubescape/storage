  "annotations": {
    "kubescape.io/report-series-id": "series-1",
    "kubescape.io/status": "ready"
  },
  "Spec": {
    "Architectures": [
      "amd64",
      "arm64"
    ],
    "Capabilities": [
      "SYS_ADMIN",
      "NET_BIND_SERVICE"
    ],
    "Execs": [
      {
        "Path": "/bin/sh",
        "Args": [
          "-c",
          "echo hi"
        ]
      },
      {
        "Path": "/usr/bin/curl",
        "Args": [
          "https://example.com"
        ]
      }
    ],
    "Opens": [
      {
        "Path": "/etc/config",
        "Flags": [
          "O_RDONLY"
        ]
      },
      {
        "Path": "/var/log/pods/pod-a/app.log",
        "Flags": [
          "O_RDONLY",
          "O_CLOEXEC"
